DUT-Anti-UAV*/
DUT Anti-UAV*/

# Generated/test videos and their outputs (can be large; regenerate locally)
*.mp4
*.avi
video_results/
external_test_results/
!docs/**/*.mp4

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
*.log

# Simulation feed is regenerated by main_pipeline.py, no need to version it
simulation_feed.json
