# Virtual environment
venv/
.venv/

# Python
__pycache__/
*.pyc
*.pyo

# Training runs (large, regeneratable via train_detector.py)
runs/
runs_dut_uav/

# Converted dataset (large, regeneratable via prepare_dataset.py; also
